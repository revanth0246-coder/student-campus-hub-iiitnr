# ==============================================================================
# IIIT-NR Student Campus Hub - Master Environment Configuration (.env.example)
# Copy this file to .env and configure credentials before starting the server.
# NEVER commit your actual .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL with SSL enabled.
# For Neon: Obtain connection string from https://console.neon.tech
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://username:password@ep-your-cluster.us-east-2.aws.neon.tech/campus_hub?sslmode=require

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Node runtime environment ('development' | 'production')
NODE_ENV=production

# Server HTTP Port (Render automatically populates this in production)
PORT=5000

# Strict CORS Whitelist: The public URL of your Vercel frontend deployment
# Example: https://iiitnr-campus-hub.vercel.app
FRONTEND_URL=https://your-app-name.vercel.app

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JSON Web Token (JWT) Secret for signing and verifying student/admin tokens.
# Generate a strong 64-character random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=generate_a_very_long_secure_random_hex_string_for_production_jwt

# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR SEED CREDENTIALS
# ------------------------------------------------------------------------------
# Used by `npm run db:seed` to provision the primary admin account
ADMIN_NAME=Chief Administrator
ADMIN_EMAIL=admin@iiitnr.ac.in
ADMIN_PASSWORD=SetAStrongAdminPassword2026!
ADMIN_DEPARTMENT=Office of Academic Affairs
ADMIN_DESIGNATION=Chief Administrator

# ------------------------------------------------------------------------------
# 5. CLOUDINARY CLOUD STORAGE (Permanent CDN Image Uploads)
# ------------------------------------------------------------------------------
# Obtain from your Cloudinary Dashboard: https://cloudinary.com/console
# Used for storing student avatars, event banners, and exchange item photos
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional alternative single URL format:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
